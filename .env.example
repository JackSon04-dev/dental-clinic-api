# Server Configuration
PORT=5000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=password123
DB_NAME=DentalClinicDB
DATABASE_URL=postgresql://admin:password123@127.0.0.1:5432/DentalClinicDB?schema=public

# Security & Authentication (JWT Secrets)
JWT_SECRET=your_jwt_access_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key

# Email Service (Nodemailer Gmail SMTP)
# Nếu để trống, hệ thống sẽ tự động in mã OTP ra Terminal/Console (Dev mode)
EMAIL_USER=your_clinic_email@gmail.com
EMAIL_PASS=your_gmail_16_digit_app_password

# ==========================================
# CLOUDINARY MEDIA STORAGE
# ==========================================
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret

# ==========================================
# PAYOS PAYMENT GATEWAY (VietQR)
# ==========================================
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_RETURN_URL=http://localhost:3100/receptionist/invoices
PAYOS_CANCEL_URL=http://localhost:3100/receptionist/invoices

# ==========================================
# FIREBASE ADMIN SDK (Google Sign-In)
# ==========================================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email@your_project.iam.gserviceaccount.com
FIREBASE_SERVICE_ACCOUNT_PATH=src/config/firebase-service-account.json

